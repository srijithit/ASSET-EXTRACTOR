{
  "manifest_version": 3,
  "name": "Asset Extractors - Web Media Extractor",
  "version": "1.1.0",
  "description": "Extract images, videos, audio, SVGs, logos, pick colors, inspect fonts, and audit SEO with one-click batch archive download. DEV by srijith (https://srijith.vercel.app/)",
  "author": "srijith (https://srijith.vercel.app/)",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Asset Extractors",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "capture_selected_area": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture Selected Area on Webpage"
    },
    "capture_full_page": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Capture Full Page Scrolling Screenshot"
    },
    "capture_visible_part": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "Command+Shift+1"
      },
      "description": "Capture Visible Part of Screen"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/jszip.min.js", "icons/*", "scripts/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
